# Dependencies
/node_modules
/server/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Testing
/coverage

# Build output
/build
/dist

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local
/server/.env
!.env.example
!/server/.env.example

# User uploads (keep the folder, ignore its contents)
/storage/uploads/*
!/storage/uploads/.gitkeep

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
/.idea/
/.vscode/
*.swp
